[Unit]
Description=UAE real estate VK and Telegram lead monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/uae-real-estate-lead-bot
EnvironmentFile=/opt/uae-real-estate-lead-bot/.env
ExecStart=/opt/uae-real-estate-lead-bot/.venv/bin/python /opt/uae-real-estate-lead-bot/bot.py
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
